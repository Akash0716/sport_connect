# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example for Neon / Render Postgres: postgresql://sport_user:password123@ep-cool-db-12345.us-east-2.aws.neon.tech/sportconnect?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sportconnect?schema=public"

# Authentication Secret
JWT_SECRET=super_secret_sportconnect_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d
